{
  "expo": {
    "name": "App de Campo",
    "slug": "app-campo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "scheme": "appcampo",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "O aplicativo usa a câmera para ler crachás e códigos do Packing House."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O aplicativo acessa suas fotos para anexá-las aos apontamentos de campo.",
          "cameraPermission": "O aplicativo usa a câmera para registrar fotos dos apontamentos de campo."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O aplicativo usa sua posição para marcar pontos no mapa da fazenda."
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "android": {
      "package": "agr.verobyorigo.appcampo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#005059"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "agr.verobyorigo.appcampo",
      "supportsTablet": false
    },
    "extra": {}
  }
}
